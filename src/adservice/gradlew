#!/bin/sh

##############################################################################
# Gradle start-up script with enhanced error handling, compatibility, and debug mode
##############################################################################

# Resolve script path
app_path=$0
while APP_HOME=${app_path%"${app_path##*/}"} && [ -h "$app_path" ]; do
    link=$(ls -ld "$app_path" | awk '{print $NF}')
    case $link in
        /*) app_path=$link ;;
        *) app_path=$APP_HOME$link ;;
    esac
done
APP_HOME=$(cd "${APP_HOME:-./}" > /dev/null && pwd -P) || exit

# OS specific support
cygwin=false
msys=false
darwin=false
nonstop=false
case "$(uname)" in
    CYGWIN*) cygwin=true ;;
    Darwin*) darwin=true ;;
    MSYS*|MINGW*) msys=true ;;
    NONSTOP*) nonstop=true ;;
esac

# Determine Java command
if [ -n "$JAVA_HOME" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
    if [ ! -x "$JAVACMD" ]; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME
Please set JAVA_HOME to a valid Java installation."
    fi
else
    JAVACMD=java
    if ! command -v java >/dev/null 2>&1; then
        die "ERROR: JAVA_HOME is not set and 'java' was not found in PATH."
    fi
fi

# JVM Options
DEFAULT_JVM_OPTS=${DEFAULT_JVM_OPTS:-"-Xmx64m -Xms64m"}

# Normalize line endings (for Windows users)
if command -v dos2unix >/dev/null 2>&1; then
    dos2unix "$0" >/dev/null 2>&1
fi

# Debug mode
if [ "$GRADLE_DEBUG" = "true" ]; then
    set -x
fi

# Collect JVM arguments
set -- \
    "-Dorg.gradle.appname=$APP_BASE_NAME" \
    -classpath "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" \
    org.gradle.wrapper.GradleWrapperMain "$@"

# Execute Gradle
exec "$JAVACMD" "$@"
